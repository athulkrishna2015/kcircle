# Maintainer: github-actions <actions@github.com>
pkgname=kcircle-bin
_pkgname=kcircle
pkgver=@@VER@@
pkgrel=1
pkgdesc="Circle to Search for KDE Plasma on Wayland (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/athulkrishna2015/kcircle"
license=('MIT')
depends=('python-pyqt6' 'python-pillow' 'spectacle')
optdepends=('python-chrome-lens-py: Google Lens visual matches')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip')
source_x86_64=("$_pkgname-$pkgver-linux-x86_64.tar.gz::$url/releases/download/v$pkgver/$_pkgname-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$_pkgname-$pkgver-linux-aarch64.tar.gz::$url/releases/download/v$pkgver/$_pkgname-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('@@X86@@')
sha256sums_aarch64=('@@ARM@@')

package() {
	local _root="$srcdir/$_pkgname-$pkgver-linux-$CARCH"
	install -Dm755 "$_root/kcircle.py" "$pkgdir/usr/share/$_pkgname/kcircle.py"
	install -Dm755 "$_root/kcircle.desktop" "$pkgdir/usr/share/applications/kcircle.desktop"
	install -Dm644 "$_root/kcircle.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/kcircle.svg"
	install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -d "$pkgdir/usr/bin"
	printf '%s\n' '#!/bin/sh' "exec python3 /usr/share/$_pkgname/kcircle.py \"\$@\"" > "$pkgdir/usr/bin/$_pkgname"
	chmod 755 "$pkgdir/usr/bin/$_pkgname"
}

#!/usr/bin/env bash
# kcircle launcher
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Prefer the native Wayland platform when we are in a Wayland session.
#
# This is not cosmetic. spectacle captures true device pixels (1920x1080 on a
# scaled panel) while Qt reports device-independent coordinates (1600x900).
# Under XWayland the two disagree about scaling and the overlay stops lining
# up with the frozen frame it is drawing. Running Qt on the same display
# server as the screenshotter keeps one coordinate system throughout.
if [[ -z "${QT_QPA_PLATFORM:-}" && -n "${WAYLAND_DISPLAY:-}" ]]; then
    export QT_QPA_PLATFORM=wayland
fi

exec "$DIR/.venv/bin/python" "$DIR/kcircle.py" "$@"

[Desktop Entry]
Type=Application
Name=Circle to Search
GenericName=Screen region search
Comment=Draw around anything on screen and search it with Google Lens
Exec=kcircle
Icon=kcircle
Terminal=false
Categories=Utility;
Keywords=circle;search;lens;ocr;translate;crop;screenshot;
# No start-up feedback: Plasma otherwise pops an animated icon at the
# pointer every time the overlay opens.
StartupNotify=false
X-KDE-StartupNotify=false
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
